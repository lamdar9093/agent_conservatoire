# Copier en .env (sur le VPS : /var/www/conservatoire/.env) et remplir.

# Base PostgreSQL Neon (Neon → Connect → chaîne de connexion « pooled »)
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Adresse publique de la plateforme (liens d'inscription et messages WhatsApp)
PUBLIC_URL=https://conservatoire.mthbichri.ca
